# Preset model ids are listed by `plan`; see README.md for setup.
# Fill only the credentials `plan` lists as required. Never put keys in a Dockerfile.

# gpt-6-astra: Azure OpenAI (the reference route). The endpoint is your resource's v1 surface URL,
# e.g. https://RESOURCE.services.ai.azure.com/openai/v1 (the adapter records the serving region).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# (aliases accepted for parity with the other packages)
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_BASE_URL=

# claude-fable-5-1, claude-opus-5-5: Anthropic API (the reference route).
ANTHROPIC_API_KEY=

# gemini-3.8-flash, gemini-4-argon: Vertex AI, global endpoint (the reference route).
# Needs Application Default Credentials for this project (gcloud auth application-default login),
# or mount a service-account key and set GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_CLOUD_PROJECT=

# SWEQnA judge panel (software-delivery only). Reference panel:
#   google:gemini-3.1-pro-preview  -> GOOGLE_CLOUD_PROJECT above (or GEMINI_API_KEY)
#   anthropic:claude-opus-5        -> ANTHROPIC_API_KEY above
#   openai:gpt-5.6-sol             -> OPENAI_API_KEY + OPENAI_BASE_URL (an Azure AI Foundry v1 URL
#                                     such as https://RESOURCE.openai.azure.com/openai/v1 serves it)
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Any other panel you can reach: PDL_JUDGES=provider:model[@base_url],... (recorded in the results)
# PDL_JUDGES=
